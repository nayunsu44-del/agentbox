{
 "build": "ok",
 "http_origin_matrix": {
  "GET /login": {
   "status": 200,
   "xfo": [
    "SAMEORIGIN"
   ],
   "csp": [
    "frame-ancestors 'self'"
   ],
   "cache": [
    "no-store"
   ]
  },
  "GET /ui (no session)": {
   "status": 303,
   "xfo": [
    "SAMEORIGIN"
   ],
   "csp": [
    "frame-ancestors 'self'"
   ],
   "location": [
    "/login"
   ]
  },
  "GET /sandboxes/{sid}/desktop (no session)": {
   "status": 401,
   "xfo": [
    "SAMEORIGIN"
   ],
   "csp": [
    "frame-ancestors 'self'"
   ]
  },
  "GET /ui/approvals (fragment, no session)": {
   "status": 401,
   "xfo": [
    "SAMEORIGIN"
   ]
  },
  "POST /login same scheme+netloc": {
   "status": 200,
   "rejected_403": false
  },
  "POST /login DIFFERENT scheme, same netloc": {
   "status": 200,
   "rejected_403": false
  },
  "POST /login different netloc": {
   "status": 403,
   "rejected_403": true
  },
  "POST /login Origin: null": {
   "status": 403,
   "rejected_403": true
  },
  "POST /login no Origin": {
   "status": 200,
   "rejected_403": false
  },
  "POST /login userinfo trick": {
   "status": 403,
   "rejected_403": true
  }
 },
 "cross_scheme_cookie_cases": {
  "GET /ui with valid cookie": {
   "status": 200
  },
  "POST /ui/approvals/{aid}/approve CROSS-SCHEME origin + valid cookie": {
   "status": 200,
   "rejected_403": false,
   "body_has_error_text": true
  },
  "POST /ui/approvals/{aid}/approve foreign origin + valid cookie": {
   "status": 403,
   "rejected_403": true
  },
  "POST /ui/sandboxes CROSS-SCHEME origin + valid cookie": {
   "raised": "AttributeError",
   "detail": "'FakeClient' object has no attribute 'images'",
   "note": "reaching the handler means the origin gate passed; docker is stubbed"
  },
  "POST /logout CROSS-SCHEME origin + valid cookie": {
   "status": 303,
   "set_cookie": [
    "agentbox_session=\"\"; expires=Fri, 23 Oct 2026 06:30:44 GMT; Max-Age=0; Path=/; SameSite=lax"
   ]
  },
  "GET /ui after that logout (same cookie)": {
   "status": 303,
   "location": [
    "/login"
   ]
  },
  "POST /logout CROSS-SCHEME origin + NO cookie": {
   "status": 303,
   "set_cookie": [
    "agentbox_session=\"\"; expires=Fri, 23 Oct 2026 06:30:44 GMT; Max-Age=0; Path=/; SameSite=lax"
   ]
  }
 },
