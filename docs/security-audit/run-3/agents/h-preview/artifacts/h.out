T5 split_segments(cmd1)
cmd: rm /workspace/harmless.txt; dd if=/dev/zero of=/workspace/important.db bs=1M count=10
{
 "segments": [
  [
   "rm",
   "/workspace/harmless.txt"
  ],
  [
   "dd",
