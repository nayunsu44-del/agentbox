== B. dev-only indicators (real desktop.page, real healthz body, base.html condition) ==
   desktop.page(runtime='runc'): red 'runc: dev only' badge=True  runtime name still printed ('격리: runc')=True
   desktop.page(runtime='io.containerd.runc.v2'): red 'runc: dev only' badge=False  runtime name still printed ('격리: io.containerd.runc.v2')=True
   api.py healthz source (lines 441-443): def health(): return {"ok": True, "runtime": box.sandboxes.runtime, "image": settings.image, "templates": sorted(settings.templates()), "dev_only": box.sandboxes.runtime == "runc"}
   healthz() with runtime='runc': {'ok': True, 'runtime': 'runc', 'image': 'img', 'templates': ['cli', 'desktop'], 'dev_only': True}
   healthz() with runtime='io.containerd.runc.v2': {'ok': True, 'runtime': 'io.containerd.runc.v2', 'image': 'img', 'templates': ['cli', 'desktop'], 'dev_only': False}
   base.html:43: <span class="badge">격리: {{ runtime }}</span>
   base.html:44: {% if runtime == "runc" %}<span class="badge warn">runc: 개발 전용 (격리 약함)</span>{% endif %}

